# Secrets - never commit these
.env
*.json.key
gcp-key*.json
service-account*.json

# Python
venv/
.venv/
__pycache__/
*.pyc

# Data files (too big for GitHub, and regenerated by the pipeline)
data/raw/*
!data/raw/.gitkeep
data/source/*
!data/source/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/
.vscode/
