# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your secrets stay on your computer.

# --- Source database (PostgreSQL in Docker) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=mysecretpassword
PG_DATABASE=dvdrental

# --- Google Cloud (used from Step 4 onwards) ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=yourname-migration-staging
BQ_DATASET=dvdrental
GOOGLE_APPLICATION_CREDENTIALS=/full/path/outside/the/repo/gcp-key.json
